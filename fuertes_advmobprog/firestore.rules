rules_version = '2';

// The handout sets both read and write to true. That would let anyone with the
// project id read and rewrite every profile and every private message, so the
// rules below grant only what the two screens actually need.
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in account may read the directory, because the chat list has
    // to show the other users. Only the owner may write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // A room is named "<uidA>_<uidB>" with the two ids sorted, so membership
    // can be checked straight off the document id.
    match /chat_rooms/{roomId} {
      allow read, write: if request.auth != null
        && request.auth.uid in roomId.split('_');

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in roomId.split('_');

        // A message may only be created by the person it says sent it.
        allow create: if request.auth != null
          && request.auth.uid in roomId.split('_')
          && request.resource.data.senderId == request.auth.uid;

        // Messages are a log; nobody edits or deletes one.
        allow update, delete: if false;
      }
    }
  }
}
